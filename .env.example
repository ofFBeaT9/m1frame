# Copy this file to .env and fill in your values
# The system reads these via os.environ — never hard-code keys in code.

# Anthropic Claude (required if backend=claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (required if backend=openai)
OPENAI_API_KEY=sk-...

# Local backends (Ollama / vLLM / LM Studio) need no key —
# just ensure the server is running on the configured port.

# ── Remote m1frame (any AI, any device) — see REMOTE.md ─────────────────────
# Optional: choose the backend/model here instead of editing config.yaml.
# M1FRAME_BACKEND=openrouter
# M1FRAME_MODEL=anthropic/claude-sonnet-5
# Public HTTPS address of this server (no trailing slash). Connectors use <url>/mcp.
M1FRAME_PUBLIC_URL=https://m1frame.example.com
# Owner password, 12+ characters. Shown as a sign-in page whenever an app connects.
M1FRAME_OWNER_PASSWORD=
# API key for chat apps using the OpenAI-compatible /v1 endpoint (also guards Studio).
M1FRAME_API_TOKEN=
# Optional: only these OAuth redirect hosts may register (comma-separated).
# M1FRAME_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,localhost,127.0.0.1
# Optional: Cloudflare named tunnel token (docker compose --profile tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=
